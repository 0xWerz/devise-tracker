{
  "name": "devise-tracker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute devise-tracker --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute devise-tracker --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
}

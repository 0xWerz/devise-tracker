{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devise-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "devise.werz.xyz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devise-tracker",
      "database_id": "c296a222-c5de-45c1-b398-f8e08bf30b1e"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SCRAPE_KEY": "3bb84821d2cfc9999e7e8b44f9b93de7"
  },
  "observability": {
    "enabled": true
  }
}
